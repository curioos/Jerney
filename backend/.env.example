# Database Configuration
DB_USER=jerney_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jerney_db

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (min 32 chars)
JWT_SECRET=your_very_long_and_secure_secret_key_at_least_32_characters_long

# Lab-only single admin user (see backend/src/routes/auth.js)
ADMIN_USERNAME=admin
# bcrypt hash of the admin password; if unset, defaults to a hash of "admin123"
ADMIN_PASSWORD_HASH=

# CORS Configuration - must match the frontend's public origin
FRONTEND_URL=http://localhost:5173
